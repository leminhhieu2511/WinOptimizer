<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area (tray) icon: System.Windows.Forms.NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Application.ThemeMode (Fluent / Windows 11 look) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyTitle>WinOptimizer</AssemblyTitle>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types (Application, MessageBox, ...) unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
