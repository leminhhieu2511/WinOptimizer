<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area (tray) icon: System.Windows.Forms.NotifyIcon. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Application.ThemeMode (Fluent / Windows 11 look) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyTitle>WinOptimizer</AssemblyTitle>
    <Version>1.0.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types (Application, MessageBox, ...) unambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native C sources/tests are built by CMake, not by the C# compiler. -->
    <Compile Remove="tests/**;native/**" />
    <Page Remove="tests/**;native/**" />
    <None Remove="tests/**;native/**" />
    <EmbeddedResource Remove="tests/**;native/**" />
  </ItemGroup>


  <!-- Build the native DiskMove projects with CMake (incremental: CMake skips up-to-date targets). -->
  <Target Name="BuildNative" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <NativeDir>$(MSBuildProjectDirectory)\native</NativeDir>
      <NativeBuildDir>$(NativeDir)\build</NativeBuildDir>
      <VsWhere>$([System.Environment]::GetEnvironmentVariable('ProgramFiles(x86)'))\Microsoft Visual Studio\Installer\vswhere.exe</VsWhere>
    </PropertyGroup>
    <Exec Command="&quot;$(VsWhere)&quot; -latest -products * -find **\CMake\bin\cmake.exe" ConsoleToMSBuild="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="CMakeExe" />
    </Exec>
    <Error Condition="'$(CMakeExe)' == '' Or !Exists('$(CMakeExe)')" Text="cmake.exe not found via vswhere. Install the Visual Studio 'C++ CMake tools for Windows' component." />
    <Exec Condition="!Exists('$(NativeBuildDir)\CMakeCache.txt')" Command="&quot;$(CMakeExe)&quot; -S &quot;$(NativeDir)&quot; -B &quot;$(NativeBuildDir)&quot; -G &quot;Visual Studio 18 2026&quot; -A x64" />
    <Exec Command="&quot;$(CMakeExe)&quot; --build &quot;$(NativeBuildDir)&quot; --config $(Configuration)" />
  </Target>

  <!-- DiskMove.dll is added only after BuildNative has produced it: a static item's Exists() is evaluated
       before any target runs, so a clean first build would miss it. (The test-only diskmove-cli is not copied.) -->
  <Target Name="AddNativeOutputs" AfterTargets="BuildNative">
    <PropertyGroup>
      <DiskMoveDll>$(MSBuildProjectDirectory)\native\build\DiskMove\$(Configuration)\DiskMove.dll</DiskMoveDll>
    </PropertyGroup>
    <Error Condition="!Exists('$(DiskMoveDll)')" Text="Native build did not produce $(DiskMoveDll)." />
    <ItemGroup>
      <None Include="$(DiskMoveDll)" Link="DiskMove.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>