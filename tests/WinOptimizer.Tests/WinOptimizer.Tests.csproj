<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Same platform as the app it references. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- UseWPF drops System.IO from the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WinOptimizer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The integration tests drive the test-only CLI that the app's BuildNative target builds with CMake
         (same configuration); it is not copied anywhere, so the tests are told where it is. -->
    <AssemblyMetadata Include="DiskMoveCliPath" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\native\build\DiskMoveCli\$(Configuration)\diskmove-cli.exe'))" />
  </ItemGroup>

</Project>
