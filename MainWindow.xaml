<Window x:Class="WinOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOptimizer"
        Width="1120" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="8,8,4,8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8,12,20">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" FontSize="20"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="WinOptimizer" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border x:Name="AdminPanel" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" Margin="4">
                <StackPanel>
                    <TextBlock Text="Limited mode" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,10"
                               Text="Some features need administrator rights." />
                    <Button Content="Restart as administrator" HorizontalAlignment="Stretch" Click="RestartAsAdmin_Click" />
                </StackPanel>
            </Border>

            <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Icon}" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="8,0,0,0" />
    </Grid>
</Window>
