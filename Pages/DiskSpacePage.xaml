<UserControl x:Class="WinOptimizer.Pages.DiskSpacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="16,16,24,0">
            <TextBlock Style="{StaticResource PageTitle}" Text="Disk Space" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Move free space from a data partition (such as D:) to the Windows drive C:. The data partition is shifted on the disk, so C: can grow while D: keeps its letter and files." />

            <!-- Debug builds only: the disk-move-test-target switch -->
            <Border x:Name="TestModeBanner" Style="{StaticResource Card}" Visibility="Collapsed"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock x:Name="TestModeText" TextWrapping="Wrap" FontWeight="SemiBold" />
            </Border>

            <!-- Limited mode: read-only map -->
            <Border x:Name="LimitedBanner" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="PageRestartButton" DockPanel.Dock="Right" Content="Restart as administrator"
                            Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" Margin="16,0,0,0"
                            Click="RestartAsAdmin_Click" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Limited mode: the disk map is read-only" />
                        <TextBlock Style="{StaticResource SecondaryText}"
                                   Text="Moving disk space changes partitions, which needs administrator rights. You can still look at the map and analyze." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- While a move runs on battery -->
            <Border x:Name="BatteryBanner" CornerRadius="8" Padding="16,12" Margin="0,0,0,8" Background="#C42B1C"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE850;" FontSize="20" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock x:Name="BatteryBannerText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Plug in your charger — the move pauses safely below 20% battery." />
                </StackPanel>
            </Border>

            <!-- Wizard steps -->
            <StackPanel x:Name="StepBar" Orientation="Horizontal" Margin="0,4,0,12">
                <TextBlock x:Name="Step1Label" Style="{StaticResource StepLabel}" Text="① Disk map" />
                <TextBlock x:Name="Step2Label" Style="{StaticResource StepLabel}" Text="② Analysis" />
                <TextBlock x:Name="Step3Label" Style="{StaticResource StepLabel}" Text="③ Amount" />
                <TextBlock x:Name="Step4Label" Style="{StaticResource StepLabel}" Text="④ Confirm" />
                <TextBlock x:Name="Step5Label" Style="{StaticResource StepLabel}" Text="⑤ Move" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
            <Grid Margin="16,0,24,24">

                <!-- ① Disk map -->
                <StackPanel x:Name="MapPanel">
                    <!-- An unfinished move the user chose to try again later (this session only) -->
                    <Border x:Name="PendingMoveBanner" Style="{StaticResource Card}" Visibility="Collapsed"
                            BorderBrush="#9D5D00" BorderThickness="2">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Go to Resume" Style="{StaticResource FooterButton}"
                                    VerticalAlignment="Center" Click="ResultResume_Click" />
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="An unfinished disk space move is waiting. No new move can start until it is finished; continue it from the Resume screen when you are ready." />
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Disks" />
                    <StackPanel x:Name="DiskMapHost" />
                    <TextBlock x:Name="MapStatusText" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />

                    <TextBlock Style="{StaticResource SectionHeader}" Text="What to move" Margin="0,16,0,8" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Take space from" VerticalAlignment="Center" Margin="0,0,16,8" />
                            <ComboBox x:Name="SourceCombo" Grid.Column="1" MinWidth="280" HorizontalAlignment="Left"
                                      Margin="0,0,0,8" SelectionChanged="SourceCombo_SelectionChanged" />
                            <TextBlock Grid.Row="1" Text="Give it to" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="TargetText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource FooterButton}" Click="Refresh_Click" />
                        <Button x:Name="AnalyzeButton" Content="Analyze" Style="{DynamicResource AccentButtonStyle}"
                                MinWidth="110" Padding="14,6" Margin="8,0,0,0" Click="Analyze_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- ② Analysis -->
                <StackPanel x:Name="AnalysisPanel" Visibility="Collapsed">
                    <TextBlock x:Name="AnalysisTitle" Style="{StaticResource SectionHeader}" Text="Analysis" />
                    <TextBlock x:Name="AnalysisSummary" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel x:Name="CheckListHost" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="AnalysisBackButton" Content="Back" Style="{StaticResource FooterButton}" Click="BackToMap_Click" />
                        <Button x:Name="CheckAgainButton" Content="Check again" Style="{StaticResource FooterButton}" Click="Analyze_Click" />
                        <Button x:Name="AnalysisNextButton" Content="Next" Style="{DynamicResource AccentButtonStyle}"
                                MinWidth="110" Padding="14,6" Margin="8,0,0,0" Click="AnalysisNext_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- ③ Amount -->
                <StackPanel x:Name="AmountPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="How much space to move" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                                    <TextBox x:Name="AmountBox" Width="90" TextAlignment="Right" VerticalAlignment="Center"
                                             LostFocus="AmountBox_LostFocus" KeyDown="AmountBox_KeyDown" />
                                    <TextBlock Text="GB" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <Slider x:Name="AmountSlider" VerticalAlignment="Center" SmallChange="1" LargeChange="10"
                                        ValueChanged="AmountSlider_ValueChanged" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock x:Name="AmountMaxText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="AmountMinText" Style="{StaticResource SecondaryText}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Before" Margin="0,12,0,4" />
                    <ContentControl x:Name="BeforeBarHost" />
                    <TextBlock Style="{StaticResource SectionHeader}" Text="After" Margin="0,12,0,4" />
                    <ContentControl x:Name="AfterBarHost" />

                    <Border Style="{StaticResource Card}" Margin="0,12,0,8">
                        <StackPanel>
                            <TextBlock x:Name="AmountResultText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DataToCopyText" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Back" Style="{StaticResource FooterButton}" Click="AmountBack_Click" />
                        <Button x:Name="AmountNextButton" Content="Next" Style="{DynamicResource AccentButtonStyle}"
                                MinWidth="110" Padding="14,6" Margin="8,0,0,0" Click="AmountNext_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- ④ Confirm -->
                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Confirm the plan" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="PlanSummaryHost" />
                    </Border>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Before you start" Margin="0,12,0,8" />
                    <StackPanel x:Name="ConfirmWarningsHost" />
                    <Border x:Name="FixFirstNote" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="#9D5D00">
                        <TextBlock x:Name="FixFirstText" TextWrapping="Wrap" />
                    </Border>
                    <CheckBox x:Name="BackupCheck" Margin="0,12,0,8" Checked="BackupCheck_Changed" Unchecked="BackupCheck_Changed">
                        <TextBlock x:Name="BackupCheckText" Text="I have backed up important data on D:" />
                    </CheckBox>
                    <TextBlock x:Name="PointOfNoReturnText" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="Once step 3 (moving the data) starts, the move cannot be cancelled — it can only be finished. If it is interrupted (crash or power loss), your data stays safe and WinOptimizer continues the move the next time it starts." />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Back" Style="{StaticResource FooterButton}" Click="ConfirmBack_Click" />
                        <Button x:Name="StartButton" Content="Start moving" Style="{DynamicResource AccentButtonStyle}"
                                MinWidth="130" Padding="14,6" Margin="8,0,0,0" IsEnabled="False" Click="Start_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Resume -->
                <StackPanel x:Name="ResumePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE777;" FontSize="24"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,14,0" />
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Unfinished disk space move" />
                                <TextBlock x:Name="ResumeText" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="ResumeDetailText" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="ContinueButton" Content="Continue" Style="{DynamicResource AccentButtonStyle}"
                                            MinWidth="120" Padding="14,6" Click="Continue_Click" />
                                    <Button x:Name="ResumeRestartButton" Content="Restart as administrator"
                                            Style="{DynamicResource AccentButtonStyle}" Padding="14,6" Click="RestartAsAdmin_Click" />
                                    <Button x:Name="ResumeLaterButton" Content="Try again later" Style="{StaticResource FooterButton}"
                                            ToolTip="Hide this screen until WinOptimizer is started again. Nothing is changed; no new move can start meanwhile."
                                            Click="ResumeLater_Click" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Disks" Margin="0,12,0,8" />
                    <StackPanel x:Name="ResumeMapHost" />
                </StackPanel>

                <!-- ⑤ Progress / Result -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ProgressTitle" Style="{StaticResource SectionHeader}" Text="Moving disk space" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel x:Name="StepListHost" />
                    </Border>
                    <Border x:Name="CopyCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="CurrentStepText" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ProgressBar x:Name="MoveProgress" Height="6" Margin="0,10,0,6" Maximum="1000" />
                            <TextBlock x:Name="SpeedText" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="LiveWarningsHost" />
                    <DockPanel x:Name="CancelRow" Margin="0,4,0,0">
                        <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource FooterButton}"
                                Click="Cancel_Click" />
                        <TextBlock x:Name="CancelHintText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                   Text="You can cancel until the data starts moving (step 3). Everything is put back as it was." />
                    </DockPanel>

                    <!-- Result -->
                    <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Border x:Name="ResultCard" Style="{StaticResource Card}" BorderThickness="2">
                            <StackPanel>
                                <TextBlock x:Name="ResultTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock x:Name="ResultSizesText" TextWrapping="Wrap" Margin="0,8,0,0" FontFamily="Consolas" />
                                <TextBlock x:Name="ResultVerifyText" TextWrapping="Wrap" Margin="0,8,0,0" />
                                <TextBox x:Name="ResultPathsText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0"
                                         Visibility="Collapsed" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ResultWarningsCard" Style="{StaticResource Card}" BorderBrush="#9D5D00" BorderThickness="2"
                                Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" FontSize="18" Foreground="#9D5D00"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Please read" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel x:Name="ResultWarningsHost" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button x:Name="OpenDiskMgmtButton" Content="Open Disk Management" Style="{StaticResource FooterButton}"
                                    Click="OpenDiskManagement_Click" />
                            <Button x:Name="ResultResumeButton" Content="Go to Resume" Style="{StaticResource FooterButton}"
                                    Visibility="Collapsed" Click="ResultResume_Click" />
                            <Button x:Name="ResultDoneButton" Content="Done" Style="{DynamicResource AccentButtonStyle}"
                                    MinWidth="110" Padding="14,6" Margin="8,0,0,0" Click="ResultDone_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
