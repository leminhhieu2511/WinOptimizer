<UserControl x:Class="WinOptimizer.Pages.PowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,16,24,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Power Mode" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Same setting as Settings › System › Power &amp; battery › Power mode. Takes effect immediately." />

            <Border x:Name="PlanWarning" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Switch to Balanced plan" Click="UseBalancedPlan_Click"
                            VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Power mode is locked by your power plan" />
                        <TextBlock x:Name="PlanWarningText" Style="{StaticResource SecondaryText}" FontSize="13" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <RadioButton x:Name="SaverRadio" GroupName="Power" Tag="BatterySaver" Checked="Mode_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Battery Life Saver" />
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="13"
                                   Text="Best power efficiency. Lowers CPU speed and background activity to make the battery last longer." />
                    </StackPanel>
                </RadioButton>
            </Border>
            <Border Style="{StaticResource Card}">
                <RadioButton x:Name="BalancedRadio" GroupName="Power" Tag="Balanced" Checked="Mode_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Balanced" />
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="13"
                                   Text="Windows balances performance and energy use automatically. Recommended for everyday use." />
                    </StackPanel>
                </RadioButton>
            </Border>
            <Border Style="{StaticResource Card}">
                <RadioButton x:Name="PerformanceRadio" GroupName="Power" Tag="HighPerformance" Checked="Mode_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Highest Performance" />
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="13"
                                   Text="Best performance. Keeps the CPU fast and responsive, using more power and producing more heat." />
                    </StackPanel>
                </RadioButton>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,8,0,0" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Command line" Margin="0,24,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="13"
                               Text="Switch modes from a shortcut or script without opening the window:" />
                    <TextBlock FontFamily="Cascadia Mono, Consolas" Margin="0,8,0,0"
                               Text="WinOptimizer.exe saver | balanced | performance" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
