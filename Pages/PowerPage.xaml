<UserControl x:Class="WinOptimizer.Pages.PowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,16,24,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Power Mode" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Same setting as Settings › System › Power &amp; battery › Power mode. Takes effect immediately." />

            <Border x:Name="PlanWarning" Style="{StaticResource Card}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Switch to Balanced plan" Click="UseBalancedPlan_Click"
                            VerticalAlignment="Center" Margin="16,0,0,0" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Power mode is locked by your power plan" />
                        <TextBlock x:Name="PlanWarningText" Style="{StaticResource SecondaryText}" FontSize="13" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <RadioButton x:Name="SaverRadio" GroupName="Power" Tag="BatterySaver" Checked="Mode_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Battery Life Saver" />
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="13"
                                   Text="Best power efficiency. Lowers CPU speed and background activity to make the battery last longer." />
                    </StackPanel>
                </RadioButton>
            </Border>
            <Border Style="{StaticResource Card}">
                <RadioButton x:Name="BalancedRadio" GroupName="Power" Tag="Balanced" Checked="Mode_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Balanced" />
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="13"
                                   Text="Windows balances performance and energy use automatically. Recommended for everyday use." />
                    </StackPanel>
                </RadioButton>
            </Border>
            <Border Style="{StaticResource Card}">
                <RadioButton x:Name="PerformanceRadio" GroupName="Power" Tag="HighPerformance" Checked="Mode_Checked">
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Highest Performance" />
                        <TextBlock Style="{StaticResource SecondaryText}" FontSize="13"
                                   Text="Best performance. Keeps the CPU fast and responsive, using more power and producing more heat." />
                    </StackPanel>
                </RadioButton>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,8,0,0" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Automatic switching" Margin="0,24,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="AutoEnabledCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Click="AutoSetting_Changed" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Change power mode when plugging in or unplugging" />
                            <TextBlock x:Name="AutoStatusText" Style="{StaticResource SecondaryText}" FontSize="13" />
                        </StackPanel>
                    </DockPanel>

                    <Grid x:Name="AutoOptions" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE83E;" VerticalAlignment="Center" />
                            <TextBlock Text="Plugged in" Margin="8,0,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="AcModeCombo" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="AutoSetting_Changed" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,8">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE859;" VerticalAlignment="Center" />
                            <TextBlock Text="On battery" Margin="8,0,0,0" />
                        </StackPanel>
                        <ComboBox x:Name="BatteryModeCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="AutoSetting_Changed" />

                        <CheckBox x:Name="AutoSwitchPlanCheck" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Click="AutoSetting_Changed"
                                  Content="Switch to the Balanced power plan when another plan blocks the change" />
                        <CheckBox x:Name="AutoNotifyCheck" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Click="AutoSetting_Changed"
                                  Content="Show a notification when the mode changes" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Command line" Margin="0,24,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" FontSize="13"
                               Text="Switch modes from a shortcut or script without opening the window:" />
                    <TextBlock FontFamily="Cascadia Mono, Consolas" Margin="0,8,0,0"
                               Text="WinOptimizer.exe saver | balanced | performance" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
