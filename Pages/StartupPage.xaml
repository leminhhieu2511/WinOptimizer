<UserControl x:Class="WinOptimizer.Pages.StartupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="Startup Apps" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                   Text="Turn off apps you don't need at sign-in to make Windows start faster. Entries are disabled the same way Task Manager does it, so you can turn them back on any time." />

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding CanChange}"
                                          Checked="Toggle_Changed" Unchecked="Toggle_Changed" Margin="16,0,0,0" />
                                <Button DockPanel.Dock="Right" ToolTip="Open file location" Click="OpenLocation_Click"
                                        VerticalAlignment="Center" Padding="8,4">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" />
                                </Button>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Command}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding SourceText}" Margin="0,2,0,0" Opacity="0.8" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
