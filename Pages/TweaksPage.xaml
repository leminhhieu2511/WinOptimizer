<UserControl x:Class="WinOptimizer.Pages.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="Privacy &amp; Tweaks" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                   Text="Each switch shows whether the tweak is currently on. Turning a switch off puts the Windows default back." />

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" x:Name="RestartExplorerButton" Click="RestartExplorer_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" VerticalAlignment="Center" />
                    <TextBlock Text="Restart Explorer" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <ItemsControl x:Name="TweakList">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="{Binding Name}" Margin="0,12,0,8" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          IsChecked="{Binding IsApplied, Mode=OneWay}" IsEnabled="{Binding CanChange}"
                                          Checked="Toggle_Changed" Unchecked="Toggle_Changed" Margin="16,0,0,0" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                                    <TextBlock Text="{Binding Badges}" Margin="0,2,0,0"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Badges}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
