<UserControl x:Class="WinOptimizer.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitle}" Text="Junk Cleaner" />
        <TextBlock Grid.Row="1" Style="{StaticResource PageSubtitle}"
                   Text="Scan for temporary and cache files that are safe to remove. Files in use are skipped automatically." />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <ItemsControl x:Name="CategoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" VerticalAlignment="Center"
                                           Margin="16,0,0,0" FontWeight="SemiBold" />
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center">
                                    <StackPanel Margin="4,0,0,0">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                                    </StackPanel>
                                </CheckBox>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ScanButton" Content="Scan" MinWidth="100" Click="Scan_Click" />
                    <Button x:Name="CleanButton" Content="Clean selected" MinWidth="130" Margin="8,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" Click="Clean_Click" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TotalText" FontSize="16" FontWeight="SemiBold" Text="Click Scan to find junk files" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryText}" />
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,6,24,0" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
